    <h2>أهلاً بك في عالم الذكاء الاصطناعي</h2>
    <form action="/login" method="post">
      <fieldset>
        <input type="text" placeholder="اسم المستخدم" required>
        <input type="password" placeholder="كلمة المرور" required><br>
        <input type="checkbox" id="save">
        <label for="save">حفظ البيانات</label>
      </fieldset>
      <input type="submit" value="تسجيل الدخول" class="nextStep">
    </form>
    <button class="nextStep" onclick="nextStep()">إنشاء حساب جديد</button>
  </div>

  
  <div id="step2" style="display:none;">
    <img src="kkk.webp" alt="شعار" width="100" height="100">
    <h5>انضم إلينا وتواصل مع المبرمجين وأدوات الذكاء الاصطناعي والمجتمعات المهتمة بنفس مجالك</h5>
    <select id="Language">
      <option>اختر لغتك</option>
      <option value="Arabic">العربية</option>
      <option value="English">الإنجليزية</option>
      <option value="Japanese">اليابانية</option>
      <option value="Spanish">الإسبانية</option>
      <option value="French">الفرنسية</option>
    </select>
    <form id="from">
      <input type="text" name="your name" placeholder="اسمك">
      <input type="text" name="your father name" placeholder="اسم الأب">
      <input type="email" name="email" placeholder="البريد الإلكتروني">
      <input type="tel" name="phone" placeholder="رقم الهاتف">
    </form>
    <button class="nextStep" onclick="nextStep()">إنشاء الحساب</button>
  </div>

  
